{
  "name": "hope-volunteer",
  "version": "0.1.0",
  "private": true,
  "description": "Volunteer shift signup for Hope Food Pantry in Sioux Center, Iowa.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "sync-brand": "node scripts/sync-brand.mjs",
    "seed": "node --env-file=.env --import tsx scripts/seed-dev.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1151.0",
    "@hono/node-server": "^2.1.5",
    "@js-temporal/polyfill": "^0.5.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
