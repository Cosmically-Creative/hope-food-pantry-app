# Local development only. Copy to .env. Do not use these values in production.
# Production startup rejects this session secret, the console mail driver, and the Turnstile test keys.

NODE_ENV=development
PORT=3000

# Public origin only. A mount prefix belongs in BASE_PATH, not here.
BASE_URL=http://127.0.0.1:3000
BASE_PATH=

# SQLite and local backups live here. npm run dev uses ./data.
# The container uses /data, which Compose sets. Do not point DATA_DIR at the filesystem root.
DATA_DIR=./data

# At least 32 characters. Production requires a random secret:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-change-me-not-for-production-use

DEFAULT_TZ=America/Chicago

# console is development-only. postmark and ses need real credentials and are not enabled by this file.
# TODO(D1): The pantry chooses the email provider and checks the sender and reply-to.
MAIL_DRIVER=console
MAIL_FROM="Hope Food Pantry <volunteer@example.invalid>"
MAIL_REPLY_TO=volunteer@example.invalid
POSTMARK_TOKEN=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=

# Cloudflare's documented always-pass test keys. They must never be used in production.
# TODO(D5): Replace them with the real site and secret keys for the public hostname.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Used by npm run sync-brand. Missing source keeps the bundled fallback.
BRAND_SRC="../Hope Food Pantry Website/brand"

# TODO(D4): Reserved for the first administrator. This step does not create that account.
BOOTSTRAP_ADMIN_EMAIL=coordinator@example.invalid

# false ignores forwarding headers. See README for loopback and Docker bridge examples.
# Do not set this to true.
TRUST_PROXY=false

# 127.0.0.1 keeps npm run dev on this computer. Compose sets 0.0.0.0 inside the container.
BIND_HOST=127.0.0.1
