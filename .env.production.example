# Copy to .env on the server that runs Docker Compose. Do not use the development .env.
# Compose forces NODE_ENV=production, DATA_DIR=/data, BIND_HOST=0.0.0.0, and TRUST_PROXY=172.30.0.0/24.
# Fill the SMTP2GO API key and Turnstile values before starting. Gmail is not a driver.
# Generate a session secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=production
PORT=3000
BASE_URL=https://volunteer.example.org
BASE_PATH=
DATA_DIR=/data
SESSION_SECRET=
DEFAULT_TZ=America/Chicago
MAIL_DRIVER=smtp2go
MAIL_FROM=Hope Food Pantry <volunteer@example.org>
MAIL_REPLY_TO=volunteer@example.org
SMTP2GO_API_KEY=
POSTMARK_TOKEN=
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BRAND_SRC=../Hope Food Pantry Website/brand
BOOTSTRAP_ADMIN_EMAIL=coordinator@example.org
BIND_HOST=0.0.0.0
